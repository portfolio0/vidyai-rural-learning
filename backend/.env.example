# VidyAI Backend Environment Configuration Template
# Duplicate this file to .env and populate with your production values.
# NEVER commit .env with real credentials into source control.

PORT=5000
NODE_ENV=development

# Frontend & CORS Configuration (comma-separated origins supported in production)
CLIENT_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:4173

# Database Connection (MongoDB Atlas or Local replica set)
MONGODB_URI=mongodb://localhost:27017/vidyai

# Security & JWT Tokens (Generate cryptographically secure 64-char strings)
JWT_SECRET=replace_with_a_secure_random_64_byte_secret_key
REFRESH_SECRET=replace_with_another_secure_random_64_byte_secret_key

# Email Service (Google App Password or SMTP Relay)
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_character_app_password

# AI Tutor Service (Groq API Key)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Cloud Media Storage Configuration (Optional: 'local' or 's3')
STORAGE_DRIVER=local
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_REGION=ap-south-1
# AWS_S3_BUCKET=vidyai-content-bucket
# AWS_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com # For Cloudflare R2